{
  "name": "hyperion",
  "version": "0.1.0",
  "description": "A local-first personal knowledge base for the web and desktop.",
  "author": "Hyperion contributors",
  "private": true,
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite",
    "dev:desktop": "npm run build:electron && concurrently -k -s first \"npm:dev:web\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:3000 && electron .",
    "build": "npm run build:web",
    "build:web": "tsc --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "build:desktop": "npm run build:web && npm run build:electron && electron-builder",
    "check:desktop": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "npm run build:web && npm run test:desktop && node --test tests/static-output.test.mjs",
    "test:desktop": "npm run build:electron && node --test tests/electron-database.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release"
  },
  "dependencies": {
    "@blocksuite/affine": "^0.22.4",
    "@phosphor-icons/react": "^2.1.10",
    "emojibase-data": "^17.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "6.0.2",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "wait-on": "^9.1.0"
  },
  "type": "module"
}

{
  "name": "hyperion",
  "version": "0.1.0",
  "description": "A local-first personal knowledge base for the web and desktop.",
  "author": "Hyperion contributors",
  "private": true,
  "packageManager": "pnpm@11.1.0",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "vite",
    "dev:desktop": "pnpm build:electron && concurrently -k -s first \"pnpm dev:web\" \"pnpm dev:electron\"",
    "dev:electron": "wait-on http://127.0.0.1:3000 && node scripts/run-electron.mjs",
    "build": "pnpm build:web",
    "build:web": "tsc --noEmit && vite build",
    "build:electron": "tsc -p electron/tsconfig.json && esbuild electron/main.ts --bundle --platform=node --format=esm --external:electron --external:electron-updater --external:node:* --outfile=dist-electron/main.js",
    "build:desktop": "pnpm build:web && pnpm build:electron && electron-builder",
    "check:desktop": "tsc -p electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "pnpm build:web && pnpm test:desktop && node --test tests/static-output.test.mjs",
    "test:desktop": "pnpm build:electron && node --test tests/electron-database.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-electron --ignore-pattern release"
  },
  "dependencies": {
    "@blocksuite/affine": "^0.22.4",
    "@blocksuite/sync": "^0.22.4",
    "@phosphor-icons/react": "^2.1.10",
    "electron-updater": "^6.8.9",
    "emojibase-data": "^17.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "6.0.2",
    "bind-event-listener": "3.0.0",
    "bytes": "3.1.2",
    "concurrently": "^10.0.4",
    "debug": "4.4.3",
    "deepmerge": "4.3.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "extend": "3.0.2",
    "globals": "16.4.0",
    "lodash.ismatch": "4.4.0",
    "picocolors": "1.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "wait-on": "^9.1.0"
  },
  "type": "module"
}
